<?xml version="1.0" encoding="UTF-8"?>
<!-- P2 T5: report jobs (spec §4.4: asynchronous, cached 24 h per (project, baseline, template), the files kept 90 days
     per §7.3). The files themselves are in sysarch.report.dir (user's decision: a local directory). No DDL in the spec. -->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="sysarch-013-report-job" author="sysarch">
        <createTable tableName="report_job">
            <column name="id" type="VARCHAR(64)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="project_id" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="baseline_id" type="VARCHAR(64)"/>
            <column name="source_label" type="VARCHAR(300)"><constraints nullable="false"/></column>
            <column name="template_id" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="cache_key" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="requested_by" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="pages" type="INTEGER"/>
            <column name="missing" type="TEXT"/>
            <column name="gaps" type="TEXT"/>
            <column name="error" type="TEXT"/>
        </createTable>
        <createIndex tableName="report_job" indexName="idx_report_job_cache"><column name="cache_key"/><column name="created_at"/></createIndex>
        <createIndex tableName="report_job" indexName="idx_report_job_project"><column name="project_id"/><column name="created_at"/></createIndex>
    </changeSet>
</databaseChangeLog>
