<?xml version="1.0" encoding="UTF-8"?>
<!-- P1 T6: per Polarion project, the three times of the sync panel and the state of the scheduled pull. -->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="sysarch-005-sync-status" author="sysarch">
        <comment>last_push_at / last_pull_at / last_check_at: the sync panel (T6 step 4). schedule_*: the incremental pull
            (T6 step 2): last success (its start is the next "since"), consecutive failures, paused after too many, the
            last error and when it runs next.</comment>
        <createTable tableName="sync_status">
            <column name="project_id" type="VARCHAR(255)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="last_push_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_pull_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_check_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="schedule_last_success_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="schedule_last_attempt_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="schedule_failures" type="INTEGER" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="schedule_paused" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="schedule_last_error" type="TEXT"/>
            <column name="schedule_next_attempt_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
