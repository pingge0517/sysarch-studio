# Copy to .env and fill in. .env is git-ignored.

# Database (required)
POSTGRES_USER=sysarch
POSTGRES_PASSWORD=

# Polarion (required from T7 on), e.g. http://localhost/polarion
POLARION_BASE_URL=
# Polarion project id -> Sirius project id or name, one variable per project (here Polarion "sysarch").
SYSARCH_POLARION_PROJECTS_SYSARCH=
# Demo only; production passes through the user's Polarion login.
POLARION_TOKEN=
# Read-only Polarion service account for the scheduled 15-minute pull only (P1 T6); empty disables it.
POLARION_SYNC_TOKEN=
CONSISTENCY_STRATEGY=MODEL_WINS
# Shared secret Polarion signs webhooks with (HMAC-SHA256); empty disables /api/v1/webhooks/polarion.
POLARION_WEBHOOK_SECRET=
SYNC_RATE_LIMIT_RPS=10
VIEW_REFRESH_BUDGET_MS=2000

# GitHub Packages access for Sirius Web artifacts (required to build the backend).
# Any GitHub personal access token with the read:packages scope.
GITHUB_ACTOR=
GITHUB_TOKEN=
# P2 T5 (leave commented for the defaults; an empty value would override them): where report files are kept (90 days),
# default data/reports under the working directory. PDFs embed the first
# existing CJK TrueType font of SYSARCH_REPORT_FONTS (comma-separated .ttf paths; defaults cover Windows and Debian/Ubuntu).
# SYSARCH_REPORT_DIR=/var/lib/sysarch/reports
# SYSARCH_REPORT_FONTS=/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf
# P2 T8 identity: users sign in with their Polarion personal access token, which is verified with Polarion and then
# forgotten; the browser keeps a cookie signed with this secret (set a long random value; empty = a new random key per
# start, so every restart signs everyone out).
SYSARCH_SESSION_SECRET=
# dev = typed names instead of Polarion (local and load tests only). Leave commented for the default (polarion).
# SYSARCH_AUTH_MODE=dev
# Embedding in Polarion (docs/polarion-embedding.md): the key shared with the SysArch extension in Polarion
# (the file sysarch.sso.secretFile names), the Polarion origin that posts the sign-on form, who may frame SysArch (empty = the origin of
# POLARION_BASE_URL) and the cookie's SameSite (Lax; None when Polarion is another site). Single sign-on also needs
# POLARION_SYNC_TOKEN to read the user's roles. Leave commented when not embedding.
# SYSARCH_POLARION_SSO_SECRET=
# SYSARCH_SSO_ORIGINS=http://localhost
# SYSARCH_FRAME_ANCESTORS=
# SYSARCH_COOKIE_SAMESITE=Lax
# false = no scheduled pull although POLARION_SYNC_TOKEN is set (the token only serves single sign-on)
# SYSARCH_SCHEDULED_PULL=true
# P3 T4 parametric solving. Locally: a Python with NumPy and SciPy (here C:\SysArchSolver\python\python.exe); in
# production use the Helm chart's isolated solver pod instead (SYSARCH_SOLVER_REMOTE_URL) and leave the Python empty.
SYSARCH_SOLVER_PYTHON=
SYSARCH_SOLVER_REMOTE_URL=
SYSARCH_SOLVER_OMC=
