# Copy to .env and fill in. .env is git-ignored.

# Database (required)
POSTGRES_USER=sysarch
POSTGRES_PASSWORD=

# Polarion (required from T7 on), e.g. http://localhost/polarion
POLARION_BASE_URL=
# Polarion project id -> Sirius project id or name, one variable per project (here Polarion "sysarch").
SYSARCH_POLARION_PROJECTS_SYSARCH=
# Demo only; production passes through the user's Polarion login.
POLARION_TOKEN=
# Read-only Polarion service account for the scheduled 15-minute pull only (P1 T6); empty disables it.
POLARION_SYNC_TOKEN=
CONSISTENCY_STRATEGY=MODEL_WINS
# Shared secret Polarion signs webhooks with (HMAC-SHA256); empty disables /api/v1/webhooks/polarion.
POLARION_WEBHOOK_SECRET=
SYNC_RATE_LIMIT_RPS=10
VIEW_REFRESH_BUDGET_MS=2000

# GitHub Packages access for Sirius Web artifacts (required to build the backend).
# Any GitHub personal access token with the read:packages scope.
GITHUB_ACTOR=
GITHUB_TOKEN=
