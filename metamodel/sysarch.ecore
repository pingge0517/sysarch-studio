<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="sysarch" nsURI="http://example.com/sysarch/1.0" nsPrefix="sysarch">

  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="系统架构建模领域元模型：SysML v2 结构子集 + Arcadia 分层标记"/>
  </eAnnotations>

  <eClassifiers xsi:type="ecore:EEnum" name="Layer">
    <eLiterals name="OPERATIONAL" value="0" literal="OPERATIONAL"/>
    <eLiterals name="SYSTEM" value="1" literal="SYSTEM"/>
    <eLiterals name="LOGICAL" value="2" literal="LOGICAL"/>
    <eLiterals name="PHYSICAL" value="3" literal="PHYSICAL"/>
    <eLiterals name="EPBS" value="4" literal="EPBS"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="PortDirection">
    <eLiterals name="IN" value="0" literal="IN"/>
    <eLiterals name="OUT" value="1" literal="OUT"/>
    <eLiterals name="INOUT" value="2" literal="INOUT"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ConnectionKind">
    <eLiterals name="ASSEMBLY" value="0" literal="ASSEMBLY"/>
    <eLiterals name="DELEGATION" value="1" literal="DELEGATION"/>
    <eLiterals name="ITEM_FLOW" value="2" literal="ITEM_FLOW"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="VerifyMethod">
    <eLiterals name="ANALYSIS" value="0" literal="ANALYSIS"/>
    <eLiterals name="INSPECTION" value="1" literal="INSPECTION"/>
    <eLiterals name="TEST" value="2" literal="TEST"/>
    <eLiterals name="DEMONSTRATION" value="3" literal="DEMONSTRATION"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ArchElement" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="NameNotEmpty" value="not name.oclIsUndefined() and name.size() &gt; 0"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="layer" eType="#//Layer" defaultValueLiteral="LOGICAL"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stereotypes" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="workItemId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rev" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="PartDefinition" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedParts" upperBound="-1"
        eType="#//Part" containment="true" eOpposite="#//Part/owner"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedPorts" upperBound="-1"
        eType="#//Port" containment="true" eOpposite="#//Port/owner"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="superTypes" upperBound="-1" eType="#//PartDefinition"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isAbstract" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Part" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="#//PartDefinition" eOpposite="#//PartDefinition/ownedParts"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="typedBy" lowerBound="1" eType="#//PartDefinition"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ports" upperBound="-1" eType="#//Port" containment="true" eOpposite="#//Port/partOwner"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="multiplicity" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Port" eSuperTypes="#//ArchElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="InterfaceTypeRequired" value="direction = PortDirection::INOUT or not interfaceType.oclIsUndefined()"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="#//PartDefinition" eOpposite="#//PartDefinition/ownedPorts"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="partOwner" eType="#//Part" eOpposite="#//Part/ports"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="direction" eType="#//PortDirection" defaultValueLiteral="INOUT"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="interfaceType" eType="#//InterfaceDef"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isConjugated" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Connection" eSuperTypes="#//ArchElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="PortInterfaceAssignable" value="kind = ConnectionKind::ASSEMBLY implies (not source.interfaceType.oclIsUndefined() and not target.interfaceType.oclIsUndefined() and source.interfaceType.compatibleWith(target.interfaceType))"/>
      <details key="NoSelfLoop" value="source &lt;&gt; target"/>
      <details key="DirectionCompatible" value="kind = ConnectionKind::ASSEMBLY implies (source.direction &lt;&gt; target.direction or source.direction = PortDirection::INOUT or target.direction = PortDirection::INOUT)"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="#//Port"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//Port"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" eType="#//ConnectionKind" defaultValueLiteral="ASSEMBLY"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="interfaceType" eType="#//InterfaceDef"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ItemFlow" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="connection" eType="#//Connection"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="itemName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="itemType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Requirement" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reqId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="verifyMethod" eType="#//VerifyMethod" defaultValueLiteral="TEST"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priority" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="satisfiedBy" upperBound="-1" eType="#//ArchElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="verifiedBy" upperBound="-1" eType="#//ArchElement"/>
  </eClassifiers>

  <!-- 新增：接口定义 -->
  <eClassifiers xsi:type="ecore:EClass" name="InterfaceDef" eSuperTypes="#//ArchElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="ProtocolRequired" value="not protocol.oclIsUndefined() and protocol.size() &gt; 0"/>
    </eAnnotations>
    <eOperations name="compatibleWith" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="P1 T2: the same entity, or one an ancestor of the other along superTypes (transitively). Implemented in Java with a cache (spec P1 §2.3); OCL calls it."/>
        <details key="body" value="return com.example.sysarch.validation.InterfaceCompatibility.compatible(this, other);"/>
      </eAnnotations>
      <eParameters name="other" eType="#//InterfaceDef"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="protocol" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dataType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="superTypes" upperBound="-1" eType="#//InterfaceDef"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Allocate" eSuperTypes="#//ArchElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="LayerAdjacentOnly" value="(from.layer = Layer::OPERATIONAL and to.layer = Layer::SYSTEM) or (from.layer = Layer::SYSTEM and to.layer = Layer::LOGICAL) or (from.layer = Layer::LOGICAL and to.layer = Layer::PHYSICAL) or (from.layer = Layer::PHYSICAL and to.layer = Layer::EPBS)"/>
      <details key="NoSelfAllocate" value="from &lt;&gt; to"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="from" lowerBound="1" eType="#//ArchElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="to" lowerBound="1" eType="#//ArchElement"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rationale" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="DiagramLayout" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="diagramKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="elementRef" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="width" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="180"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="height" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="90"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="waypoints" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- P3 T1: metamodel v1.3, spec §2.2 [COPY], verbatim but for two marked insertions -->
  <eClassifiers xsi:type="ecore:EClass" name="ConstraintBlock" eSuperTypes="#//ArchElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="HasExpression" value="not expression.oclIsUndefined()"/>
      <details key="ParamsHaveUnit" value="parameters->forAll(p | not p.unit.oclIsUndefined() and p.unit.size() &gt; 0)"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parameters" lowerBound="1" upperBound="-1"
        eType="#//Parameter" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="expression" lowerBound="1" eType="#//ConstraintExpr" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Parameter" eSuperTypes="#//ArchElement">
    <!-- P3 T1 (user's decision): direction stays a string as in the snippet; this constraint limits its values -->
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="DirectionKnown" value="direction.oclIsUndefined() or direction = &apos;IN&apos; or direction = &apos;OUT&apos; or direction = &apos;INOUT&apos;"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unit" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="direction" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="IN"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="defaultValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ConstraintExpr">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="language" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="PYTHON"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="body" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="declaredVars" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="BindingConnector" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="#//Parameter"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//Parameter"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="StateMachine" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="states" upperBound="-1" eType="#//State" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="transitions" upperBound="-1" eType="#//Transition" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="State" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isInitial" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isFinal" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="doBehavior" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- P3 T1 (user's decision): entry/exit of spec §2.1's table, next to the snippet's doBehavior -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="entryBehavior" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="exitBehavior" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Transition" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="#//State"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//State"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="trigger" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="guard" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="effect" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- P3 T1: Activity / Action / UseCase / Actor (spec §2.1 "同构实现"; design agreed with the user). Action.kind is an
       enum (spec); ActivityFlow carries the flows of an activity, isObjectFlow = dashed object flow. -->
  <eClassifiers xsi:type="ecore:EEnum" name="ActionKind">
    <eLiterals name="CALL" value="0" literal="CALL"/>
    <eLiterals name="ASSIGN" value="1" literal="ASSIGN"/>
    <eLiterals name="DECIDE" value="2" literal="DECIDE"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Activity" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="actions" upperBound="-1" eType="#//Action" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="flows" upperBound="-1" eType="#//ActivityFlow" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Action" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" eType="#//ActionKind" defaultValueLiteral="CALL"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expression" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ActivityFlow" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="#//Action"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//Action"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isObjectFlow" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="UseCase" eSuperTypes="#//ArchElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="actors" upperBound="-1" eType="#//Actor"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subject" eType="#//PartDefinition"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Actor" eSuperTypes="#//ArchElement"/>

</ecore:EPackage>
