# Sirius Web front-end packages come from GitHub Packages (like the backend's Maven artifacts): set NPM_TOKEN to a
# classic PAT with read:packages (CI: secrets.GPR_TOKEN). Obeo's gantt package pins @types/react exactly, hence legacy peer deps.
@eclipse-sirius:registry=https://npm.pkg.github.com
@ObeoNetwork:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
legacy-peer-deps=true
