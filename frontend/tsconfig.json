{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@eclipse-sirius/sirius-components-core": [
        "./node_modules/@eclipse-sirius/sirius-components-core/dist/index.d.ts"
      ],
      "@eclipse-sirius/sirius-components-diagrams": [
        "./node_modules/@eclipse-sirius/sirius-components-diagrams/dist/index.d.ts"
      ],
      "@eclipse-sirius/sirius-web-application": [
        "./node_modules/@eclipse-sirius/sirius-web-application/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
