{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/sysarch/vsm/1.0/vsm.schema.json",
  "title": "VSM DSL 1.0",
  "description": "Declarative view definitions (spec §4.2). The field set is closed: it is exactly what P0 §4.2-§4.4 and P1 §3.2-§3.5 use. New fields need review (spec §10.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["vsm", "viewpoint", "representations"],
  "properties": {
    "vsm": { "const": "1.0" },
    "viewpoint": { "$ref": "#/$defs/viewpoint" },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/representation" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "representationId": {
      "description": "lowerCamel or kebab-case (P1: sa-function-chain); names the generated class, e.g. SaFunctionChainDiagramDescriptionProvider",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(-[a-z0-9][A-Za-z0-9]*)*$"
    },
    "classRef": {
      "description": "<nsPrefix>:<EClass>, e.g. sysarch:PartDefinition",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9_]*:[A-Z][A-Za-z0-9_]*$"
    },
    "featureName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
    "template": {
      "description": "Label template; {feature} or {ref.feature} is interpolated, everything else is literal",
      "type": "string"
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "positiveInt": { "type": "integer", "minimum": 1 },
    "viewpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "metamodelUri"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$" },
        "label": { "type": "string" },
        "metamodelUri": { "type": "string" },
        "priority": { "type": "integer" }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/representationId" },
        "label": { "type": "string" },
        "kind": { "enum": ["diagram", "table"] },
        "domainClass": { "$ref": "#/$defs/classRef" },
        "synchronization": { "enum": ["auto", "manual"] },
        "refresh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "budgetMs"],
          "properties": {
            "mode": { "const": "incremental" },
            "budgetMs": { "$ref": "#/$defs/positiveInt" }
          }
        },
        "autoExpand": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["feature", "maxDepth"],
            "properties": {
              "feature": { "$ref": "#/$defs/featureName" },
              "maxDepth": { "$ref": "#/$defs/positiveInt" }
            }
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "expression"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "expression": { "type": "string", "minLength": 1 }
            }
          }
        },
        "nodeStyles": { "type": "array", "items": { "$ref": "#/$defs/nodeStyle" } },
        "nodeStylesExtra": { "description": "P3 T3: more node styles, the same as nodeStyles (appended to them)", "type": "array", "items": { "$ref": "#/$defs/nodeStyle" } },
        "edgeStyles": { "type": "array", "items": { "$ref": "#/$defs/edgeStyle" } },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
        "rows": { "$ref": "#/$defs/axis" },
        "columns": { "$ref": "#/$defs/axis" },
        "cells": { "$ref": "#/$defs/cells" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/tableAction" } }
      },
      "if": { "properties": { "kind": { "const": "diagram" } } },
      "then": {
        "required": ["domainClass", "nodeStyles", "synchronization"],
        "properties": { "rows": false, "columns": false, "cells": false, "actions": false }
      },
      "else": {
        "required": ["domainClass", "rows", "columns", "cells"],
        "properties": { "synchronization": false, "refresh": false, "autoExpand": false, "filters": false, "nodeStyles": false, "nodeStylesExtra": false, "edgeStyles": false, "tools": false }
      }
    },
    "axis": {
      "description": "P1 table rows or columns: every element of class (in the model) that passes filter, labelled, optionally grouped",
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "labelExpression"],
      "properties": {
        "class": { "$ref": "#/$defs/classRef" },
        "filter": { "type": "string", "minLength": 1 },
        "labelExpression": { "$ref": "#/$defs/template" },
        "groupBy": { "$ref": "#/$defs/featureName" }
      }
    },
    "cells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existsExpression", "markSymbol"],
      "properties": {
        "existsExpression": { "type": "string", "minLength": 1 },
        "markSymbol": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "tableAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "action": { "enum": ["create-link", "delete-link", "link"] },
        "targetClass": { "$ref": "#/$defs/classRef" },
        "validateOnCreate": { "type": "boolean" },
        "feature": { "$ref": "#/$defs/featureName" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "create-link" } } },
          "then": { "required": ["targetClass", "validateOnCreate"], "properties": { "feature": false } }
        },
        {
          "if": { "properties": { "action": { "const": "delete-link" } } },
          "then": { "properties": { "targetClass": false, "validateOnCreate": false, "feature": false } }
        },
        {
          "if": { "properties": { "action": { "const": "link" } } },
          "then": { "required": ["feature"], "properties": { "targetClass": false, "validateOnCreate": false } }
        }
      ]
    },
    "nodeStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "appliesTo"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "appliesTo": { "$ref": "#/$defs/classRef" },
        "shape": { "enum": ["rectangle", "rounded-rectangle", "square"] },
        "color": { "$ref": "#/$defs/color" },
        "borderColor": { "$ref": "#/$defs/color" },
        "borderWidth": { "$ref": "#/$defs/positiveInt" },
        "headerBold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "width": { "$ref": "#/$defs/positiveInt" },
        "height": { "$ref": "#/$defs/positiveInt" },
        "isBorderNode": { "type": "boolean" },
        "affiliationFeature": { "$ref": "#/$defs/featureName" },
        "labelPosition": { "enum": ["inside", "outside"] },
        "labelExpression": { "$ref": "#/$defs/template" },
        "subLabelExpression": { "$ref": "#/$defs/template" },
        "compartments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["feature", "label", "itemExpression"],
            "properties": {
              "feature": { "$ref": "#/$defs/featureName" },
              "label": { "type": "string" },
              "itemExpression": { "$ref": "#/$defs/template" }
            }
          }
        }
      }
    },
    "edgeStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domainClass", "sourceEnd", "targetEnd"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/template" },
        "labelExpression": { "$ref": "#/$defs/template" },
        "domainClass": { "$ref": "#/$defs/classRef" },
        "sourceEnd": { "type": "string", "pattern": "^(self|[a-z][A-Za-z0-9_]*)$" },
        "targetEnd": { "type": "string", "pattern": "^(self|[a-z][A-Za-z0-9_]*)$" },
        "routing": { "enum": ["straight", "manhattan", "spline"] },
        "arrow": { "enum": ["hollow-triangle", "filled-diamond", "open"] },
        "lineStyle": { "enum": ["solid", "dashed"] },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "action": { "enum": ["create-child", "create-edge", "external-link"] },
        "targetClass": { "$ref": "#/$defs/classRef" },
        "containmentFeature": { "$ref": "#/$defs/featureName" },
        "linkType": { "enum": ["POLARION_WORKITEM"] },
        "validateOnDrop": { "type": "boolean" },
        "defaults": {
          "description": "create-child: attribute values a new element gets (P1 §3.5), e.g. layer: SYSTEM",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/featureName" },
          "additionalProperties": { "type": ["string", "boolean", "integer"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "create-child" } } },
          "then": { "required": ["targetClass"] }
        },
        {
          "if": { "properties": { "action": { "const": "create-edge" } } },
          "then": { "required": ["targetClass", "validateOnDrop"] }
        },
        {
          "if": { "properties": { "action": { "const": "external-link" } } },
          "then": { "required": ["linkType"] }
        }
      ]
    }
  }
}
