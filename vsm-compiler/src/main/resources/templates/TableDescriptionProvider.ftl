<#-- One provider per VSM table representation (spec P1 §3.3). Data: package, t = ViewModel.Table. -->
<#function q s><#return '"' + s?j_string + '"'></#function>
<#macro axis a>Axis.of(${q(a.type())}, ${q(a.labelTemplate())})<#if a.filter()??>.filter(${q(a.filter())})</#if><#if a.groupBy()??>.groupBy(${q(a.groupBy())})</#if></#macro>
// GENERATED by vsm-compiler from ${t.sourceFile()}. DO NOT EDIT.
// Change the YAML, then run: ./gradlew :vsm-compiler:generateViews
package ${package};

import com.example.sysarch.view.api.*;

import org.springframework.stereotype.Component;

@Component
public class ${t.className()} implements ITableDescriptionProvider {

    @Override
    public TableDescription build() {
        return TableDescription.newTableDescription(${q(t.id())})
<#if t.label()??>
            .label(${q(t.label())})
</#if>
            .domainType(${q(t.domainType())})
            .rows(<@axis t.rows()/>)
            .columns(<@axis t.columns()/>)
            // ${t.cellExpression()}
            .cells(${t.cellConditionJava()},
                ${q(t.cellExpression())}, ${q(t.markSymbol())}, <#if t.markColor()??>${q(t.markColor())}<#else>null</#if>)
<#list t.actions() as a>
<#if a.action() == "CREATE_LINK">
            .addAction(TableAction.createLink(${q(a.id())}, ${q(a.label())}, ${q(a.targetClass())}, ${a.validateOnCreate()?c}))
<#elseif a.action() == "DELETE_LINK">
            .addAction(TableAction.deleteLink(${q(a.id())}, ${q(a.label())}))
<#else>
            .addAction(TableAction.link(${q(a.id())}, ${q(a.label())}, ${q(a.feature())}))
</#if>
</#list>
            .build();
    }
}
